---
import '@/styles/global.css'
import '@/styles/immersive.css'
import '@/styles/typography.css'

import Footer from '@/components/footer.astro'
import Head from '@/components/head.astro'
import Header from '@/components/header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
  variant?: 'default' | 'landing' | 'immersive'
}

const { class: className, variant = 'default' } = Astro.props
---

<!doctype html>
<html lang={SITE.locale} data-theme="light">
  <Head>
    <slot name="head" />
  </Head>
  <body
    class={`site-shell site-shell--${variant} flex min-h-screen flex-col font-sans`}
    data-route-shell={variant}
  >
    <a href="#main-content" class="skip-link"> Skip to main content </a>
    <header class="site-header sticky top-0 z-50">
      <Header variant={variant} />
      <slot name="subposts-navigation" />
      <slot name="table-of-contents" />
    </header>
    <main
      id="main-content"
      tabindex="-1"
      class={cn('site-main-shell flex w-full grow flex-col', className)}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
