---
import Link from '@/components/link.astro'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const readTime = await getCombinedReadingTime(entry.id)
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
---

<article class="post-row">
  <Link href={`/${entry.collection}/${entry.id}`} class="post-row__link">
    <div class="post-row__meta">
      <p class="t-label">{formatDate(entry.data.date)}</p>
      <p class="t-label t-muted">
        {readTime}
        {subpostCount > 0 && <span> / {subpostCount} parts</span>}
      </p>
    </div>
    <div class="post-row__main">
      <h3 class="post-row__title">{entry.data.title}</h3>
      <p class="post-row__description">{entry.data.description}</p>
      {
        entry.data.tags && (
          <ul class="post-row__tags" aria-label="Tags">
            {entry.data.tags.map((tag) => (
              <li class="tag tag--quiet">#{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="post-row__aside" aria-hidden="true">
      {
        entry.data.image && (
          <span class="post-row__thumb">
            <Image
              src={entry.data.image}
              alt=""
              width={320}
              height={168}
              fit="contain"
              loading="lazy"
            />
          </span>
        )
      }
      <span class="post-row__arrow">↗</span>
    </div>
  </Link>
</article>

<style>
  .post-row {
    border-top: 1px dotted var(--rule);
  }

  .post-row__link {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto;
    gap: 32px;
    padding-block: 32px 36px;
  }

  .post-row__meta {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .post-row__title {
    max-width: 24ch;
    font-size: clamp(1.6rem, 2.6vw, 2.35rem);
    font-weight: 350;
    line-height: 1.04;
    letter-spacing: -0.04em;
    transition: color 0.2s;
  }

  .post-row__link:hover .post-row__title {
    color: var(--blue);
  }

  .post-row__description {
    max-width: 44rem;
    margin-top: 14px;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.6;
  }

  .post-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }

  .post-row__aside {
    display: flex;
    align-items: start;
    gap: 20px;
  }

  .post-row__thumb {
    display: block;
    width: 132px;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    background: var(--blue);
  }

  .post-row__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .post-row__arrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted-foreground);
    transition:
      transform 0.2s,
      color 0.2s;
  }

  .post-row__link:hover .post-row__arrow {
    color: var(--blue);
    transform: translate(2px, -2px);
  }

  @media (max-width: 1023px) {
    .post-row__link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 18px 24px;
    }

    .post-row__meta {
      grid-column: 1 / -1;
      grid-auto-flow: column;
      justify-content: start;
      gap: 16px;
    }
  }

  @media (max-width: 639px) {
    .post-row__thumb {
      display: none;
    }
  }
</style>
