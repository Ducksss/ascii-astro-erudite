---
import Link from '@/components/link.astro'
import { cn } from '@/lib/utils'

const { newerPost, olderPost, parentPost } = Astro.props
const isSubpost = !!parentPost
const links = [
  {
    label: isSubpost ? 'Previous part' : 'Previous note',
    post: olderPost,
    empty: isSubpost ? 'No earlier part' : "You're at the oldest note",
    arrow: '←',
    align: 'start',
  },
  ...(isSubpost
    ? [
        {
          label: 'Parent note',
          post: parentPost,
          empty: 'No parent note',
          arrow: '↑',
          align: 'center',
        },
      ]
    : []),
  {
    label: isSubpost ? 'Next part' : 'Next note',
    post: newerPost,
    empty: isSubpost ? 'No later part' : "You're at the newest note",
    arrow: '→',
    align: 'end',
  },
]
---

<nav
  aria-label="Post navigation"
  class={cn(
    'post-nav grid grid-cols-1 gap-x-4 gap-y-10',
    isSubpost ? 'sm:grid-cols-3' : 'sm:grid-cols-2',
  )}
>
  {
    links.map(({ label, post, empty, arrow, align }) => (
      <div class={`post-nav__item post-nav__item--${align}`}>
        <span class="tab post-nav__tab">{label}</span>
        <Link
          href={post ? `/blog/${post.id}#post-title` : '#'}
          class={cn(
            'frame-double post-nav__link',
            !post && 'post-nav__link--empty',
          )}
          aria-disabled={!post}
          tabindex={post ? undefined : -1}
        >
          <span class="frame-double__panel post-nav__panel">
            <span class="post-nav__arrow" aria-hidden="true">
              {arrow}
            </span>
            <span class="post-nav__title">{post?.data.title ?? empty}</span>
          </span>
        </Link>
      </div>
    ))
  }
</nav>

<style>
  .post-nav__item {
    position: relative;
  }

  .post-nav__tab {
    position: absolute;
    bottom: 100%;
    left: 0;
  }

  .post-nav__item--end .post-nav__tab {
    right: 0;
    left: auto;
  }

  .post-nav__link {
    --frame: var(--border);
    height: 100%;
    transition: border-color 0.2s;
  }

  .post-nav__link:hover {
    --frame: var(--ink);
  }

  .post-nav__link--empty {
    pointer-events: none;
    cursor: not-allowed;
    opacity: 0.5;
  }

  .post-nav__panel {
    display: flex;
    min-height: 6.5rem;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    padding: 16px 18px;
    background: var(--paper-raised);
  }

  .post-nav__item--end .post-nav__panel {
    align-items: end;
    text-align: right;
  }

  .post-nav__item--center .post-nav__panel {
    align-items: center;
    text-align: center;
  }

  .post-nav__arrow {
    font-family: var(--font-mono);
    color: var(--blue);
  }

  .post-nav__title {
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
</style>
