---
import Link from '@/components/link.astro'
import { formatDate } from '@/lib/utils'
import type { CollectionEntry } from 'astro:content'

interface Props {
  title: string
  intro: string
  featuredPost: CollectionEntry<'blog'> | null
  supportingPosts: CollectionEntry<'blog'>[]
  stats: { postCount: number; tagCount: number; yearSpan: string }
}
const { title, intro, featuredPost, supportingPosts, stats } = Astro.props
const posts = featuredPost
  ? [featuredPost, ...supportingPosts]
  : supportingPosts
---

<section class="archive-section" aria-labelledby="archive-title">
  <div class="site-container">
    <div class="archive-heading">
      <p class="technical-label">Field notes / the thinking behind the doing</p>
      <h2 id="archive-title" class="section-title">{title}</h2>
      <p>{intro}</p>
    </div>
    <div class="technical-rule" aria-hidden="true"></div>
    <div class="archive-grid">
      {
        posts.map((post, index) => (
          <article class="archive-note">
            <Link href={`/blog/${post.id}`}>
              <div class="archive-note__meta technical-label">
                <>
                  <span class="archive-note__tab">
                    {String(index + 1).padStart(2, '0')} / Field note
                  </span>
                  <span aria-hidden="true">↗</span>
                </>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="archive-note__date technical-label">
                <>
                  <span>{formatDate(post.data.date)}</span>
                  <span class="archive-note__avatar" aria-hidden="true">
                    <img
                      src="/static/logo.png"
                      width="28"
                      height="28"
                      alt=""
                      loading="lazy"
                    />
                  </span>
                </>
              </div>
            </Link>
          </article>
        ))
      }
    </div>
    <div class="archive-directory">
      <p class="technical-label">
        {String(stats.postCount).padStart(2, '0')} notes <span>/</span>
        {String(stats.tagCount).padStart(2, '0')} topics <span>/</span>
        {stats.yearSpan}
      </p>
      <Link href="/blog" class="technical-button"
        >Open the archive <span aria-hidden="true">↗</span></Link
      >
    </div>
  </div>
  <div class="cross-field archive-cross-field" aria-hidden="true"></div>
</section>

<style>
  .archive-section {
    position: relative;
    padding-block: 70px 170px;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }
  .archive-section > .site-container {
    position: relative;
    z-index: 1;
  }
  .archive-heading {
    text-align: center;
    margin-bottom: 48px;
  }
  .archive-heading .technical-label {
    color: #686863;
    font-size: 9px;
  }
  .archive-heading h2 {
    margin-top: 22px;
  }
  .archive-heading > p:last-child {
    color: #666661;
    font-size: 15px;
    margin-top: 20px;
  }
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 50px;
  }
  .archive-note {
    background: #eeeeea;
    transition: background 0.2s;
  }
  .archive-note:hover {
    background: #e7e7e0;
  }
  .archive-note > a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px;
  }
  .archive-note__meta {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    color: #62625e;
  }
  .archive-note__meta > span:last-child {
    color: var(--blue);
  }
  .archive-note__tab {
    border-inline: 1px solid #999991;
    padding-inline: 7px;
    line-height: 20px;
  }
  .archive-note h3 {
    font-family: var(--font-display);
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: 350;
    line-height: 1.12;
    letter-spacing: -0.04em;
    margin-top: 32px;
  }
  .archive-note > a > p {
    margin-top: 20px;
    margin-bottom: 32px;
    color: #60605a;
    font-size: 14px;
    line-height: 1.6;
  }
  .archive-note__date {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding-top: 14px;
    margin-top: auto;
    border-top: 1px dotted #b0b0a8;
    color: #63635e;
    font-size: 8px;
  }
  .archive-note__avatar {
    width: 28px;
    height: 28px;
    background: var(--blue);
  }
  .archive-note__avatar img {
    filter: grayscale(1) brightness(1.5);
    object-fit: cover;
    mix-blend-mode: screen;
  }
  .archive-directory {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 32px;
  }
  .archive-directory .technical-label {
    color: #646460;
    font-size: 9px;
  }
  .archive-directory .technical-label span {
    padding-inline: 8px;
    color: #a4a49d;
  }
  .archive-cross-field {
    position: absolute;
    inset: auto 0 0;
    height: 135px;
    opacity: 0.65;
    mask-image:
      radial-gradient(ellipse at 12% 100%, #000 25%, transparent 70%),
      radial-gradient(ellipse at 52% 100%, #000 20%, transparent 65%),
      radial-gradient(ellipse at 98% 100%, #000 15%, transparent 65%);
  }
  @media (max-width: 1023px) {
    .archive-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .archive-section {
      padding-block: 50px 120px;
    }
    .archive-heading {
      margin-bottom: 36px;
    }
    .archive-grid {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }
    .archive-note > a {
      padding: 22px;
    }
    .archive-note h3 {
      font-size: 25px;
      margin-top: 22px;
    }
    .archive-note > a > p {
      font-size: 14px;
      margin-top: 16px;
    }
    .archive-directory {
      flex-direction: column;
      align-items: start;
    }
    .archive-cross-field {
      height: 85px;
    }
  }
</style>
