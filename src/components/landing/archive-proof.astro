---
import BrandMark from '@/components/brand-mark.astro'
import Link from '@/components/link.astro'
import { getCombinedReadingTime } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  featuredPost: CollectionEntry<'blog'> | null
  supportingPosts: CollectionEntry<'blog'>[]
  stats: { postCount: number; tagCount: number; yearSpan: string }
}

const { featuredPost, supportingPosts, stats } = Astro.props
const posts = featuredPost
  ? [featuredPost, ...supportingPosts]
  : supportingPosts
const readingTimes = await Promise.all(
  posts.map((post) => getCombinedReadingTime(post.id)),
)
---

<section class="notes surface-paper" aria-labelledby="notes-title">
  <span class="field notes__pixels" aria-hidden="true"></span>
  <div class="site-container">
    <div class="notes__head">
      <p class="t-label t-muted">Field notes / the thinking behind the doing</p>
      <h2 id="notes-title" class="t-title notes__title">
        Notes from the work<span class="t-dim">…</span>
      </h2>
      <span class="rule-dotted" aria-hidden="true"></span>
    </div>

    <div class="notes__grid">
      {
        posts.map((post, index) => (
          <article class="note-card">
            <Link href={`/blog/${post.id}`} class="note-card__link">
              <p class="bracketed t-label note-card__kicker">
                Note {String(index + 1).padStart(2, '0')}
              </p>
              <h3>{post.data.title}</h3>
              <p class="note-card__quote">{post.data.description}</p>
              <span
                class="rule-dotted rule-dotted--start note-card__rule"
                aria-hidden="true"
              />
              <div class="note-card__meta">
                <div>
                  <p class="t-label t-muted">{formatDate(post.data.date)}</p>
                  <p>{readingTimes[index]}</p>
                </div>
                <span class="note-card__thumb" aria-hidden="true">
                  {post.data.image ? (
                    <Image
                      src={post.data.image}
                      alt=""
                      width={112}
                      height={112}
                      fit="cover"
                      loading="lazy"
                    />
                  ) : (
                    <BrandMark />
                  )}
                </span>
              </div>
            </Link>
          </article>
        ))
      }
    </div>

    <div class="notes__directory">
      <p class="t-label t-muted">
        {String(stats.postCount).padStart(2, '0')} notes /
        {String(stats.tagCount).padStart(2, '0')} topics / {stats.yearSpan}
      </p>
      <Link href="/blog" class="btn btn--solid">
        Open the archive <span aria-hidden="true">↗</span>
      </Link>
    </div>
  </div>
  <span class="field notes__skyline" aria-hidden="true"></span>
</section>

<style>
  .notes {
    overflow: hidden;
    padding-block: var(--section-y) calc(var(--section-y) + 120px);
  }

  .notes > .site-container {
    position: relative;
    z-index: 1;
  }

  .notes__title {
    margin-top: 24px;
  }

  .notes__head .rule-dotted {
    margin-top: clamp(28px, 3.5vw, 48px);
  }

  .notes__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .note-card {
    background: var(--paper-raised);
    outline: 1px solid #e3e3e3;
    outline-offset: -1px;
    transition: outline-color 0.2s;
  }

  .note-card:hover {
    outline-color: var(--ink);
  }

  .note-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px 22px 18px;
  }

  .note-card__kicker {
    color: var(--muted-foreground);
  }

  .note-card h3 {
    margin-top: 28px;
    font-size: clamp(1.3rem, 1.75vw, 1.6rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .note-card__quote {
    margin-top: 16px;
    margin-bottom: 30px;
    color: #3f3f3f;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .note-card__rule {
    margin-top: auto;
    margin-left: 6px;
  }

  .note-card__meta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
    font-size: 0.875rem;
  }

  .note-card__meta p + p {
    margin-top: 4px;
  }

  .note-card__thumb {
    display: grid;
    flex: none;
    place-items: center;
    width: 56px;
    height: 56px;
    overflow: hidden;
    background: var(--blue);
    color: #fff;
  }

  .note-card__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: url('#duotone-blue') contrast(1.1);
  }

  .note-card__thumb :global(svg) {
    width: 24px;
    height: 24px;
  }

  .notes__directory {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 36px;
  }

  .notes__pixels {
    top: 34%;
    right: 0;
    width: 392px;
    height: 504px;
    color: var(--blue);
    -webkit-mask: url('/fields/pixels.svg') right center / contain no-repeat;
    mask: url('/fields/pixels.svg') right center / contain no-repeat;
  }

  .notes__skyline {
    right: 0;
    bottom: 0;
    left: 0;
    height: 240px;
    color: #b4b4b4;
    -webkit-mask: url('/fields/cross-skyline.svg') left bottom repeat-x;
    mask: url('/fields/cross-skyline.svg') left bottom repeat-x;
  }

  @media (max-width: 1023px) {
    .notes__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .notes__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .notes__pixels {
      width: 200px;
      height: 260px;
    }
  }
</style>
