---
import AsciiObject from '@/components/ascii-object.astro'
import Link from '@/components/link.astro'
import type { AsciiObjectName } from '@/lib/ascii'
import type { CollectionEntry } from 'astro:content'

interface Props {
  projects: CollectionEntry<'projects'>[]
}

const { projects } = Astro.props
const cards: {
  label: string
  summary: string
  surface: 'ink' | 'blue' | 'paper'
  object: AsciiObjectName
}[] = [
  {
    label: 'Adoption',
    summary:
      'Guided onboarding, clearer charts and a user guide that helps people find their own way.',
    surface: 'ink',
    object: 'bars',
  },
  {
    label: 'Readiness',
    summary:
      'Automated training systems that lifted efficiency by 70% across 40+ operators.',
    surface: 'blue',
    object: 'padlock',
  },
  {
    label: 'Delivery',
    summary:
      'Developer tooling, automated release checks and a portal reaching 6k weekly users.',
    surface: 'paper',
    object: 'chain',
  },
]
const shortName = (name: string) =>
  name === 'Government Technology Agency' ? 'GovTech' : name
---

<section id="work" class="work surface-paper" aria-labelledby="work-title">
  <div class="site-container">
    <p class="t-label t-muted">Selected work / 2022 – 2026</p>
    <h2 id="work-title" class="t-statement work__statement">
      Strong technology only matters when people can use it.
      <span class="t-dim">That's where I come in.</span>
    </h2>

    <div class="work__grid">
      {
        projects.map((project, index) => {
          const card = cards[index % cards.length]
          return (
            <article class:list={['work-card', `work-card--${card.surface}`]}>
              <span class="tab work-card__tab">
                {String(index + 1).padStart(2, '0')} / {card.label}
              </span>
              <Link
                href={project.data.link}
                external={project.data.link.startsWith('http')}
                class="frame-double work-card__frame"
              >
                <div
                  class={`frame-double__panel work-card__panel surface-${card.surface}`}
                >
                  <div class="work-card__art" aria-hidden="true">
                    <AsciiObject
                      object={card.object}
                      tone={card.surface}
                      cols={78}
                      rows={46}
                      zoom={card.object === 'chain' ? 1.02 : 0.98}
                      invert={card.surface === 'paper'}
                      class={
                        card.surface === 'ink' ? 'ascii--bright' : undefined
                      }
                      trails={
                        card.surface === 'blue'
                          ? { density: 0.3, length: 22, side: 'left' }
                          : false
                      }
                      size="clamp(3.6px, 0.5vw, 7.2px)"
                    />
                  </div>
                  <div class="work-card__body">
                    <p class="t-label t-muted">{project.data.role}</p>
                    <h3>{shortName(project.data.name)}</h3>
                    <p class="work-card__summary">
                      {card.summary ?? project.data.description}
                    </p>
                    <span class="work-card__action t-label">
                      Explore the work <span aria-hidden="true">↗</span>
                    </span>
                  </div>
                </div>
              </Link>
            </article>
          )
        })
      }
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: var(--section-y) calc(var(--section-y) * 1.1);
    scroll-margin-top: 72px;
  }

  .work__statement {
    max-width: 21ch;
    margin-top: 28px;
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(24px, 4.5vw, 72px);
    margin-top: clamp(72px, 8vw, 120px);
  }

  .work-card {
    position: relative;
    --frame: #9c9c9c;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .work-card:hover {
    transform: translateY(-6px);
  }

  .work-card--ink {
    margin-top: clamp(80px, 11vw, 168px);
  }

  .work-card--blue {
    margin-top: clamp(150px, 19vw, 290px);
  }

  .work-card__tab {
    position: absolute;
    bottom: 100%;
    left: 0;
  }

  .work-card__frame {
    display: block;
    background: var(--paper);
  }

  .work-card__panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .work-card--blue .work-card__panel {
    flex-direction: column-reverse;
  }

  .work-card--paper .work-card__panel {
    --background: var(--paper-raised);
  }

  .work-card__art {
    display: grid;
    place-items: center;
    aspect-ratio: 1.12;
    overflow: hidden;
  }

  .work-card__body {
    padding: 4px 20px 6px;
  }

  .work-card--blue .work-card__body {
    padding-top: 22px;
  }

  .work-card h3 {
    margin-top: 12px;
    font-size: clamp(1.5rem, 2.3vw, 2rem);
    font-weight: 350;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .work-card__summary {
    margin-top: 12px;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .work-card__action {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    border-top: 1px dotted var(--rule);
  }

  @media (max-width: 1023px) {
    .work__grid {
      gap: 20px;
    }

    .work-card__body {
      padding-inline: 14px;
    }
  }

  @media (max-width: 767px) {
    .work__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 64px;
      max-width: 440px;
      margin-inline: auto;
    }

    .work-card--ink,
    .work-card--blue {
      margin-top: 0;
    }

    .work-card__art {
      aspect-ratio: 1.5;
    }
  }
</style>
