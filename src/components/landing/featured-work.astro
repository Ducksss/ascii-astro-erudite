---
import Link from '@/components/link.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  title: string
  intro: string
  projects: CollectionEntry<'projects'>[]
}
const { title, intro, projects } = Astro.props
const cardLabels = ['Adoption', 'Readiness', 'Delivery']
const summaries = [
  'Guided onboarding, clearer charts, and a user guide that helps people find their own way.',
  'Automated training systems that improved efficiency by 70% across 40+ operators.',
  'Developer tooling, automated release checks, and a portal reaching 6k weekly users.',
]
---

<section id="work" class="proof-section" aria-labelledby="work-title">
  <div class="site-container">
    <p class="technical-label">Selected work / from product to practice</p>
    <h2 id="work-title" class="section-title">
      {title}<br /><span>{intro}</span>
    </h2>
    <div class="proof-grid">
      {
        projects.map((project, index) => (
          <article class:list={['proof-card', `proof-card--${index + 1}`]}>
            <span class="proof-card__tab technical-label">
              {String(index + 1).padStart(2, '0')} / {cardLabels[index]}
            </span>
            <Link
              href={project.data.link}
              external={project.data.link.startsWith('http')}
              class="proof-card__link"
            >
              <div class="proof-card__visual">
                <img
                  src={
                    [
                      '/static/signal-orbit.svg',
                      '/static/signal-stack.svg',
                      '/static/signal-knot.svg',
                    ][index]
                  }
                  alt=""
                  width="600"
                  height="450"
                  loading="lazy"
                  class="proof-card__image"
                />
              </div>
              <div class="proof-card__body">
                <p class="technical-label">{project.data.role}</p>
                <h3>
                  {project.data.name === 'Government Technology Agency'
                    ? 'GovTech'
                    : project.data.name}
                </h3>
                <p class="proof-card__summary">
                  {summaries[index] ?? project.data.description}
                </p>
                <span class="proof-card__action technical-label">
                  Explore the work <span aria-hidden="true">↗</span>
                </span>
              </div>
            </Link>
          </article>
        ))
      }
    </div>
  </div>
  <div class="cross-field proof-cross-field" aria-hidden="true"></div>
</section>

<style>
  .proof-section {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    padding-block: 96px 150px;
    scroll-margin-top: 88px;
    overflow: hidden;
  }
  .proof-section > .site-container {
    position: relative;
    z-index: 1;
  }
  .proof-section > .site-container > .technical-label {
    color: #646460;
  }
  .proof-section h2 {
    max-width: 950px;
    margin-top: 24px;
    font-size: clamp(32px, 4.6vw, 66px);
    line-height: 1.03;
  }
  .proof-section h2 span {
    color: #70706b;
  }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(30px, 5vw, 88px);
    margin-top: 65px;
  }
  .proof-card {
    position: relative;
    border: 1px solid #a4a4a0;
    padding: 8px;
    background: var(--paper);
    transition: transform 0.25s;
  }
  .proof-card:hover {
    transform: translateY(-6px);
  }
  .proof-card--1 {
    margin-top: 75px;
  }
  .proof-card--2 {
    margin-top: 170px;
  }
  .proof-card__tab {
    position: absolute;
    bottom: 100%;
    left: -1px;
    padding: 5px 7px;
    background: var(--ink);
    color: white;
    font-size: 8px;
  }
  .proof-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid #62625e;
  }
  .proof-card__visual {
    position: relative;
    aspect-ratio: 1.3;
    overflow: hidden;
    background: #171717;
    color: #d9d9d3;
  }
  .proof-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.95;
  }
  .proof-card__body {
    background: #171717;
    color: white;
    padding: 22px 16px 16px;
  }
  .proof-card__body > .technical-label {
    color: #bdbdb7;
    font-size: 8px;
    line-height: 1.5;
  }
  .proof-card h3 {
    font-family: var(--font-display);
    margin-top: 12px;
    font-size: clamp(21px, 2.2vw, 29px);
    font-weight: 350;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .proof-card__summary {
    margin-top: 15px;
    color: #bdbdb7;
    font-size: 14px;
    line-height: 1.5;
  }
  .proof-card__action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    margin-top: 20px;
    border-top: 1px dotted #555;
    font-size: 8px;
  }
  .proof-card--2 .proof-card__body,
  .proof-card--2 .proof-card__visual {
    background: var(--blue);
    color: white;
  }
  .proof-card--2 .proof-card__image {
    opacity: 0.95;
    mix-blend-mode: screen;
    object-fit: cover;
    object-position: right bottom;
  }
  .proof-card--2 .proof-card__body {
    order: -1;
    padding-top: 26px;
  }
  .proof-card--2 .proof-card__visual {
    aspect-ratio: 1.1;
  }
  .proof-card--2 .proof-card__link {
    border-color: #a2a3ff;
  }
  .proof-card--2 .proof-card__body > .technical-label,
  .proof-card--2 .proof-card__summary {
    color: #e1e1ff;
  }
  .proof-card--2 .proof-card__action {
    border-color: #ffffff60;
  }
  .proof-card--3 .proof-card__body,
  .proof-card--3 .proof-card__visual {
    background: #eeeee9;
    color: var(--ink);
  }
  .proof-card--3 .proof-card__image {
    opacity: 0.8;
    filter: grayscale(1) invert(1);
    mix-blend-mode: multiply;
    object-fit: cover;
    object-position: center;
  }
  .proof-card--3 .proof-card__body > .technical-label,
  .proof-card--3 .proof-card__summary {
    color: #646460;
  }
  .proof-card--3 .proof-card__action {
    border-color: #bdbdb7;
  }
  .proof-cross-field {
    position: absolute;
    inset: auto 0 0;
    height: 370px;
    opacity: 0.45;
    mask-image:
      linear-gradient(transparent, #000),
      radial-gradient(ellipse at 12% 100%, #000 20%, transparent 65%),
      radial-gradient(ellipse at 83% 100%, #000 15%, transparent 70%);
  }
  @media (max-width: 1023px) {
    .proof-grid {
      gap: 24px;
    }
    .proof-card--1 {
      margin-top: 40px;
    }
    .proof-card--2 {
      margin-top: 100px;
    }
    .proof-card__body {
      padding: 18px 12px 12px;
    }
  }
  @media (max-width: 639px) {
    .proof-section {
      padding-block: 65px 80px;
    }
    .proof-section h2 {
      font-size: 34px;
    }
    .proof-grid {
      grid-template-columns: 1fr;
      gap: 45px;
      margin-top: 48px;
      max-width: 360px;
      margin-inline: auto;
    }
    .proof-card--1,
    .proof-card--2 {
      margin-top: 0;
    }
    .proof-card__visual {
      aspect-ratio: 1.7;
    }
    .proof-card--2 .proof-card__visual {
      aspect-ratio: 1.5;
    }
    .proof-card__body {
      padding: 20px;
    }
    .proof-card h3 {
      font-size: 28px;
    }
    .proof-card__summary {
      font-size: 14px;
    }
  }
</style>
