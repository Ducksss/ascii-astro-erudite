---
import Breadcrumbs from '@/components/breadcrumbs.astro'

interface IntroBreadcrumbItem {
  href?: string
  label: string
  icon?: string
}

interface Props {
  items?: IntroBreadcrumbItem[]
  label: string
  title: string
  description?: string | string[]
}

const { items = [], label, title, description } = Astro.props

const paragraphs = Array.isArray(description)
  ? description
  : description
    ? [description]
    : []

const hasAside = Astro.slots.has('aside')
const hasDefaultSlot = Astro.slots.has('default')
---

<section class="editorial-intro relative overflow-hidden">
  <div class="site-container py-12 lg:py-20">
    {items.length > 0 && <Breadcrumbs variant="immersive" items={items} />}

    <div
      class:list={[
        'mt-8',
        hasAside &&
          'grid gap-12 xl:grid-cols-[minmax(0,1.4fr)_minmax(260px,0.6fr)] xl:items-end',
      ]}
    >
      <div class="immersive-animate-in max-w-4xl" transition:name="page-intro">
        <p class="technical-label">{label}</p>
        <h1 class="section-title mt-5 max-w-4xl">{title}</h1>

        {
          paragraphs.length > 0 && (
            <div class="immersive-copy mt-6 max-w-2xl text-base leading-7 sm:text-lg sm:leading-8">
              {paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          )
        }

        {hasDefaultSlot && <slot />}
      </div>

      {
        hasAside && (
          <aside class="immersive-panel immersive-animate-in self-end">
            <slot name="aside" />
          </aside>
        )
      }
    </div>
  </div>
</section>
