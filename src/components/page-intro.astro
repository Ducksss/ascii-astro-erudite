---
import Breadcrumbs, {
  type BreadcrumbItem,
} from '@/components/breadcrumbs.astro'

interface Props {
  items?: BreadcrumbItem[]
  label: string
  title: string
  description?: string
  /** Tab label on the aside's double frame. */
  asideLabel?: string
}

const { items = [], label, title, description, asideLabel } = Astro.props
const hasAside = Astro.slots.has('aside')
---

<section class="page-intro surface-blue">
  <span class="field page-intro__field" aria-hidden="true"></span>
  <div class="site-container page-intro__inner">
    {items.length > 0 && <Breadcrumbs items={items} />}
    <div
      class:list={['page-intro__grid', hasAside && 'page-intro__grid--aside']}
    >
      <div class="page-intro__main rise-in" transition:name="page-intro">
        <p class="t-label page-intro__label">
          <span class="mark-cross" aria-hidden="true"></span>
          {label}
        </p>
        <h1 class="t-title page-intro__title">{title}</h1>
        {description && <p class="page-intro__description">{description}</p>}
        <slot />
      </div>
      {
        hasAside && (
          <aside class="page-intro__aside rise-in">
            {asideLabel && (
              <span class="tab page-intro__tab">{asideLabel}</span>
            )}
            <div class="frame-double">
              <div class="frame-double__panel page-intro__panel">
                <slot name="aside" />
              </div>
            </div>
          </aside>
        )
      }
    </div>
  </div>
</section>

<style>
  .page-intro {
    overflow: hidden;
  }

  .page-intro__field {
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    color: rgb(255 255 255 / 0.32);
    -webkit-mask-image: url('/fields/cross-corner.svg');
    mask-image: url('/fields/cross-corner.svg');
    -webkit-mask-position: right top;
    mask-position: right top;
    -webkit-mask-size: 1100px auto;
    mask-size: 1100px auto;
  }

  .page-intro__inner {
    position: relative;
    padding-block: clamp(28px, 3.4vw, 48px) clamp(64px, 8vw, 112px);
  }

  .page-intro__grid {
    margin-top: clamp(48px, 7vw, 104px);
  }

  .page-intro__grid--aside {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
    align-items: end;
    gap: clamp(40px, 6vw, 96px);
  }

  .page-intro__label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted-foreground);
  }

  .page-intro__title {
    max-width: 15ch;
    margin-top: 22px;
  }

  .page-intro__description {
    max-width: 40rem;
    margin-top: 28px;
    color: var(--muted-foreground);
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    letter-spacing: -0.01em;
  }

  .page-intro__aside {
    position: relative;
    --frame: rgb(255 255 255 / 0.5);
  }

  .page-intro__tab {
    position: absolute;
    bottom: 100%;
    left: 0;
  }

  .page-intro__panel {
    padding: 22px 22px 24px;
  }

  @media (max-width: 1023px) {
    .page-intro__grid--aside {
      grid-template-columns: minmax(0, 1fr);
      gap: 56px;
    }

    .page-intro__aside {
      max-width: 420px;
    }
  }
</style>
