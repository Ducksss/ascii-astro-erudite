---
import Link from '@/components/link.astro'
import { LANDING, NAV_LINKS, PROFILE } from '@/consts'

interface Props {
  variant?: 'default' | 'landing' | 'immersive'
}

const linkedInLink = PROFILE.links.find((item) => item.label === 'LinkedIn')!
const path = Astro.url.pathname
---

<div class="site-header-shell site-container">
  <Link href="/" class="site-brand" aria-label={`${LANDING.name} — home`}>
    <span class="site-brand__symbol" aria-hidden="true">c<span>p</span>z</span>
    <span class="site-brand__name">Chai Pin Zheng</span>
  </Link>
  <nav class="site-navigation" aria-label="Main navigation">
    <Link href="/#work" class="site-navigation__work">Work <sup>01</sup></Link>
    {
      NAV_LINKS.map((item, index) => (
        <Link
          href={item.href}
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label} <sup>{String(index + 2).padStart(2, '0')}</sup>
        </Link>
      ))
    }
  </nav>
  <Link
    href={linkedInLink.href}
    external
    class="technical-button technical-button--white site-header-contact"
  >
    Let's connect <span aria-hidden="true">↗</span>
  </Link>
</div>
