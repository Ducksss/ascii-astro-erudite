---
import Link from '@/components/link.astro'
import type { SocialLink } from '@/types'
import type { CollectionEntry } from 'astro:content'

interface Props {
  author: CollectionEntry<'authors'>
}

const { author } = Astro.props
const { name, avatar, bio, pronouns } = author.data
const isAuthorPage =
  Astro.url.pathname.replace(/\/$/, '') === `/authors/${author.id}`

const socialLinks: SocialLink[] = [
  author.data.website && { href: author.data.website, label: 'Website' },
  author.data.github && { href: author.data.github, label: 'GitHub' },
  author.data.twitter && { href: author.data.twitter, label: 'Twitter' },
  author.data.linkedin && { href: author.data.linkedin, label: 'LinkedIn' },
  author.data.mail && { href: `mailto:${author.data.mail}`, label: 'Email' },
].filter(Boolean) as SocialLink[]
---

<article class="author-card">
  <span class="tab author-card__tab">Author</span>
  <div class="frame-double">
    <div class="frame-double__panel author-card__panel">
      <span class="author-card__avatar" aria-hidden="true">
        <img src={avatar} alt="" width="112" height="112" loading="lazy" />
      </span>
      <div class="author-card__body">
        <p class="bracketed t-label author-card__kicker">
          {pronouns ?? 'Profile'}
        </p>
        <h2 class="author-card__name">
          {
            isAuthorPage ? (
              name
            ) : (
              <Link href={`/authors/${author.id}`}>{name}</Link>
            )
          }
        </h2>
        {bio && <p class="author-card__bio">{bio}</p>}
        <span class="rule-dotted rule-dotted--start" aria-hidden="true"></span>
        <ul class="author-card__links" aria-label={`${name} elsewhere`}>
          {
            socialLinks.map(({ href, label }) => (
              <li>
                <Link href={href} external class="link-line">
                  {label} <span aria-hidden="true">↗</span>
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</article>

<style>
  .author-card {
    position: relative;
    max-width: 880px;
    --frame: var(--rule);
  }

  .author-card__tab {
    position: absolute;
    bottom: 100%;
    left: 0;
  }

  .author-card__panel {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: clamp(20px, 3vw, 40px);
    padding: clamp(20px, 2.6vw, 32px);
    background: var(--paper-raised);
  }

  .author-card__avatar {
    display: block;
    width: 112px;
    height: 112px;
    overflow: hidden;
    background: var(--blue);
  }

  .author-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: url('#duotone-blue') contrast(1.06);
  }

  .author-card__kicker {
    color: var(--muted-foreground);
  }

  .author-card__name {
    margin-top: 18px;
    font-size: clamp(1.9rem, 3.2vw, 2.75rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .author-card__name :global(a:hover) {
    color: var(--blue);
  }

  .author-card__bio {
    max-width: 40rem;
    margin-top: 16px;
    color: #3f3f3f;
    font-size: 1rem;
    line-height: 1.6;
  }

  .author-card .rule-dotted {
    margin-top: 24px;
    margin-left: 6px;
  }

  .author-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin-top: 8px;
  }

  @media (max-width: 639px) {
    .author-card__panel {
      grid-template-columns: minmax(0, 1fr);
    }

    .author-card__avatar {
      width: 88px;
      height: 88px;
    }
  }
</style>
