---
import Link from '@/components/link.astro'
import TechnicalSymbol from '@/components/technical-symbol.astro'
import { FOOTER } from '@/consts'
---

<footer class="site-footer" transition:persist>
  <div class="cross-field cross-field--footer" aria-hidden="true"></div>
  <div class="site-container">
    <div class="footer-invitation">
      <p class="technical-label">
        The next good thing starts with a conversation.
      </p>
      <h2>Real work. Real impact.<br />Let's build it.</h2>
      <div class="footer-symbols" aria-hidden="true">
        <div><TechnicalSymbol kind="delivery" /><span>Build</span></div>
        <div><TechnicalSymbol kind="adoption" /><span>Adopt</span></div>
        <div><TechnicalSymbol kind="systems" /><span>Operate</span></div>
      </div>
      <div class="footer-actions">
        <Link
          href={FOOTER.primaryContact.href}
          class="technical-button technical-button--blue"
        >
          Get in touch <span aria-hidden="true">↗</span>
        </Link>
        <Link href="/about" class="technical-button"
          >More about me <span aria-hidden="true">↗</span></Link
        >
      </div>
    </div>

    <div class="footer-directory">
      <div class="footer-directory__intro">
        <span class="technical-cross" aria-hidden="true">+ +</span>
        <p>Making complex<br />systems feel simple.</p>
        <span class="technical-label"
          >{FOOTER.baseValue} / software engineer</span
        >
      </div>
      <nav aria-label="Footer navigation">
        <Link href="/#work"
          >Selected work <span aria-hidden="true">↗</span></Link
        >
        <Link href="/about">About <span aria-hidden="true">↗</span></Link>
        <Link href="/blog">Writing <span aria-hidden="true">↗</span></Link>
        <Link href="/tags"
          >Explore topics <span aria-hidden="true">↗</span></Link
        >
      </nav>
      <div class="footer-directory__links">
        {
          FOOTER.contactLinks.map((item) => (
            <Link href={item.href} external={item.href.startsWith('http')}>
              {item.label} <span aria-hidden="true">↗</span>
            </Link>
          ))
        }
      </div>
    </div>
    <div class="footer-colophon technical-label">
      <span>© {FOOTER.signature}. All rights reserved.</span>
      <Link href={FOOTER.primaryContact.href}
        >{FOOTER.primaryContact.label}</Link
      >
      <span>Built with intent <span aria-hidden="true">↗</span></span>
    </div>
    <div class="footer-wordmark" aria-hidden="true">
      <svg viewBox="0 0 1200 270" fill="none">
        <defs>
          <pattern
            id="wordmark-pixels"
            x="800"
            y="14"
            width="408"
            height="240"
            patternUnits="userSpaceOnUse"
