---
import BlogCard from '@/components/blog-card.astro'
import PageHead from '@/components/page-head.astro'
import PageIntro from '@/components/page-intro.astro'
import PaginationComponent from '@/components/ui/pagination'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { getAllPosts, groupPostsByYear } from '@/lib/data-utils'
import type { PaginateFunction } from 'astro'

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const allPosts = await getAllPosts()
  const archiveYearCount = new Set(
    allPosts.map((post) => post.data.date.getUTCFullYear()),
  ).size

  return paginate(allPosts, {
    pageSize: SITE.postsPerPage,
    props: { archiveYearCount },
  })
}

const { page, archiveYearCount } = Astro.props

const postsByYear = groupPostsByYear(page.data)
const years = Object.keys(postsByYear).sort((a, b) => parseInt(b) - parseInt(a))
const pad = (value: number) => String(value).padStart(2, '0')
---

<Layout>
  <PageHead
    slot="head"
    title="Blog"
    description="Build logs, hackathon writeups, and technical notes that stay close to shipped work."
  />

  <PageIntro
    items={[
      { label: 'Writing', href: '/blog' },
      { label: `Page ${page.currentPage}` },
    ]}
    label="Writing / archive"
    title="Notes from the work."
    description="Build logs, hackathon writeups and technical notes. What I built, what changed and the decisions behind it."
    asideLabel="Archive"
  >
    <div slot="aside" class="stat-row">
      <div>
        <p class="stat__value">{pad(page.total)}</p>
        <p class="t-label stat__label">Notes</p>
      </div>
      <div>
        <p class="stat__value">{pad(archiveYearCount)}</p>
        <p class="t-label stat__label">Years</p>
      </div>
      <div>
        <p class="stat__value">
          {pad(page.currentPage)}<span class="t-dim">/{pad(page.lastPage)}</span
          >
        </p>
        <p class="t-label stat__label">Page</p>
      </div>
    </div>
  </PageIntro>

  <section class="archive surface-paper">
    <div class="site-container">
      {
        years.map((year) => (
          <section class="archive__year" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="archive__year-label">
              <span class="tab">{year}</span>
              <span class="rule-dotted" aria-hidden="true" />
            </h2>
            <div>
              {postsByYear[year].map((post) => (
                <BlogCard entry={post} />
              ))}
            </div>
          </section>
        ))
      }

      <div class="archive__pagination">
        <PaginationComponent
          currentPage={page.currentPage}
          totalPages={page.lastPage}
          baseUrl="/blog/"
          variant="immersive"
          client:load
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  .archive {
    padding-block: clamp(64px, 8vw, 112px) var(--section-y);
  }

  .archive__year + .archive__year {
    margin-top: 56px;
  }

  .archive__year-label {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 8px;
  }

  .archive__year-label .rule-dotted {
    flex: 1;
  }

  .archive__pagination {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
</style>
