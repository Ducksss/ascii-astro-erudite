---
import BlogCard from '@/components/blog-card.astro'
import ImmersivePageIntro from '@/components/immersive-page-intro.astro'
import PageHead from '@/components/page-head.astro'
import PaginationComponent from '@/components/ui/pagination'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { getAllPosts, groupPostsByYear } from '@/lib/data-utils'
import type { PaginateFunction } from 'astro'

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const allPosts = await getAllPosts()
  const archiveYearCount = new Set(
    allPosts.map((post) => post.data.date.getUTCFullYear()),
  ).size

  return paginate(allPosts, {
    pageSize: SITE.postsPerPage,
    props: { archiveYearCount },
  })
}

const { page, archiveYearCount } = Astro.props

const postsByYear = groupPostsByYear(page.data)
const years = Object.keys(postsByYear).sort((a, b) => parseInt(b) - parseInt(a))
const pagePosition = `${String(page.currentPage).padStart(2, '0')}/${String(page.lastPage).padStart(2, '0')}`
---

<Layout variant="immersive">
  <PageHead
    slot="head"
    title="Blog"
    description="Build logs, hackathon writeups, and technical notes that stay close to shipped work."
  />

  <ImmersivePageIntro
    items={[
      { label: 'Writing', href: '/blog', icon: 'lucide:library-big' },
      { label: `Page ${page.currentPage}`, icon: 'lucide:book-copy' },
    ]}
    label="Writing / Archive"
    title="Notes from the work."
    description="Build logs, hackathon writeups, and technical notes. What I built, what changed, and the decisions behind it."
  >
    <div slot="aside">
      <p class="technical-label">Archive snapshot</p>
      <div
        class="mt-6 grid grid-cols-3 divide-x divide-border border-t border-border pt-5"
      >
        <div class="pr-3">
          <p class="text-3xl font-normal tracking-[-0.05em]">
            {String(page.total).padStart(2, '0')}
          </p>
          <p class="technical-label mt-3">Notes</p>
        </div>
        <div class="px-3">
          <p class="text-3xl font-normal tracking-[-0.05em]">
            {String(archiveYearCount).padStart(2, '0')}
          </p>
          <p class="technical-label mt-3">Years</p>
        </div>
        <div class="pl-3">
          <p class="text-3xl font-normal tracking-[-0.05em]">{pagePosition}</p>
          <p class="technical-label mt-3">Page</p>
        </div>
      </div>
    </div>
  </ImmersivePageIntro>

  <section class="editorial-section border-b border-border">
    <div class="site-container py-16 lg:py-24">
      <div class="flex min-h-[calc(100vh-18rem)] flex-col gap-y-10">
        {
          years.map((year) => (
            <section class="grid gap-4 border-t border-border pt-6 xl:grid-cols-[9rem_minmax(0,1fr)] xl:gap-10">
              <div class="technical-label text-primary">{year}</div>
              <div class="flex flex-col">
                {postsByYear[year].map((post) => (
                  <BlogCard entry={post} variant="immersive" />
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <div class="mt-10 border-t border-border pt-8">
        <PaginationComponent
          currentPage={page.currentPage}
          totalPages={page.lastPage}
          baseUrl="/blog/"
          variant="immersive"
          client:load
        />
      </div>
    </div>
  </section>
</Layout>
