---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PostHead from '@/components/post-head.astro'
import PostNavigation from '@/components/post-navigation.astro'
import SubpostsHeader from '@/components/subposts-header.astro'
import SubpostsSidebar from '@/components/subposts-sidebar.astro'
import TOCHeader from '@/components/toc-header.astro'
import TOCSidebar from '@/components/toc-sidebar.astro'
import { Button } from '@/components/ui/button'
import Layout from '@/layouts/layout.astro'
import {
  getAdjacentPosts,
  getAllPostsAndSubposts,
  getCombinedReadingTime,
  getParentId,
  getParentPost,
  getPostReadingTime,
  getSubpostCount,
  getTOCSections,
  hasSubposts,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { render } from 'astro:content'
import 'katex/dist/katex.min.css'

export async function getStaticPaths() {
  const posts = await getAllPostsAndSubposts()
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }))
}

const post = Astro.props
const currentPostId = Astro.params.id
const { Content, headings } = await render(post)
const authors = await parseAuthors(post.data.authors ?? [])

const isCurrentSubpost = isSubpost(currentPostId)
const navigation = await getAdjacentPosts(currentPostId)
const parentPost = isCurrentSubpost ? await getParentPost(currentPostId) : null

const hasChildPosts = await hasSubposts(currentPostId)
const subpostCount = !isCurrentSubpost
  ? await getSubpostCount(currentPostId)
  : 0
const postReadingTime = await getPostReadingTime(currentPostId)
const combinedReadingTime =
  hasChildPosts && !isCurrentSubpost
    ? await getCombinedReadingTime(currentPostId)
    : null

const tocSections = await getTOCSections(currentPostId)
---

<Layout>
  <PostHead slot="head" post={post} />
  {
    (hasChildPosts || isCurrentSubpost) && (
      <SubpostsHeader
        slot="subposts-navigation"
        parentId={isCurrentSubpost ? getParentId(currentPostId) : currentPostId}
      />
    )
  }
  {
    headings?.length > 0 &&
      !(
        isCurrentSubpost &&
        headings.length === 1 &&
        headings[0].text === post.data.title
      ) && <TOCHeader slot="table-of-contents" headings={headings} />
  }

  <section
    class:list={[
      'post-intro surface-blue',
      post.data.image && 'post-intro--figure',
    ]}
  >
    <div class="site-container post-intro__inner">
      <Breadcrumbs
        items={[
          { href: '/blog', label: 'Writing' },
          ...(isCurrentSubpost && parentPost
            ? [
                {
                  href: `/blog/${parentPost.id}`,
                  label: parentPost.data.title,
                },
                { href: `/blog/${currentPostId}`, label: post.data.title },
              ]
            : [{ href: `/blog/${currentPostId}`, label: post.data.title }]),
        ]}
      />

      <div class="post-intro__grid">
        <div class="post-intro__main rise-in" transition:name="page-intro">
          <p class="t-label post-intro__label">
            <span class="mark-cross" aria-hidden="true"></span>
            {isCurrentSubpost ? 'Field note / part' : 'Field note'}
          </p>
          <h1 class="t-title post-intro__title scroll-mt-31" id="post-title">
            {post.data.title}
          </h1>

          {
            post.data.description && (
              <p class="post-intro__description">{post.data.description}</p>
            )
          }

          <div class="post-intro__byline">
            {
              authors.map((author) => (
                <span class="tag tag--solid post-intro__author">
                  <Image
                    src={author.avatar}
                    alt=""
                    width={20}
                    height={20}
                    class="post-intro__avatar"
                  />
                  {author.isRegistered ? (
                    <Link href={`/authors/${author.id}`}>{author.name}</Link>
                  ) : (
                    <span>{author.name}</span>
                  )}
                </span>
              ))
            }
            {
              post.data.tags?.map((tag) => (
                <a href={`/tags/${tag}`} class="tag">
                  #{tag}
                </a>
              ))
            }
          </div>
        </div>

        <aside class="post-intro__aside rise-in">
          <span class="tab post-intro__tab">Reading</span>
          <div class="frame-double">
            <dl class="frame-double__panel meta-list post-intro__panel">
              <div>
                <dt class="t-label">Published</dt>
                <dd>{formatDate(post.data.date)}</dd>
              </div>
              {
                post.data.updated && (
                  <div>
                    <dt class="t-label">Updated</dt>
                    <dd>{formatDate(post.data.updated)}</dd>
                  </div>
                )
              }
              <div>
                <dt class="t-label">Reading time</dt>
                <dd>
                  {postReadingTime}
                  {
                    combinedReadingTime &&
                      combinedReadingTime !== postReadingTime && (
                        <span class="t-muted">
                          {' '}
                          / {combinedReadingTime} total
                        </span>
                      )
                  }
                </dd>
              </div>
              {
                subpostCount > 0 && (
                  <div>
                    <dt class="t-label">Structure</dt>
                    <dd>
                      {subpostCount} part{subpostCount === 1 ? '' : 's'}
                    </dd>
                  </div>
                )
              }
            </dl>
          </div>
        </aside>
      </div>

      {
        post.data.image && (
          <figure class="post-figure frame-brackets">
            <Image
              src={post.data.image}
              alt={post.data.title}
              width={1200}
              height={630}
              class="post-figure__image"
              transition:name="page-media"
            />
          </figure>
        )
      }
    </div>
  </section>

  <section
    class:list={[
      'post-body surface-paper',
      post.data.image && 'post-body--after-figure',
    ]}
  >
    <div class="site-container">
      <div
        class="grid gap-8 xl:grid-cols-[minmax(140px,0.7fr)_minmax(0,720px)_minmax(140px,0.7fr)] xl:items-start"
      >
        {
          tocSections.length > 0 && (
            <TOCSidebar sections={tocSections} currentPostId={currentPostId} />
          )
        }

        <div class="col-start-1 min-w-0 space-y-16 xl:col-start-2">
          <article class="prose max-w-none">
            <Content />
          </article>

          <PostNavigation
            newerPost={navigation.newer}
            olderPost={navigation.older}
            parentPost={isCurrentSubpost ? navigation.parent : undefined}
          />
        </div>

        {
          (hasChildPosts || isCurrentSubpost) && (
            <SubpostsSidebar
              parentId={
                isCurrentSubpost ? getParentId(currentPostId) : currentPostId
              }
            />
          )
        }
      </div>
    </div>
  </section>

  <Button
    variant="outline"
    size="icon"
    className="scroll-top group fixed right-8 bottom-8 z-50 hidden rounded-none"
    id="scroll-to-top"
    title="Scroll to top"
    aria-label="Scroll to top"
  >
    <Icon
      name="lucide:arrow-up"
      class="mx-auto size-4 transition-all group-hover:-translate-y-0.5"
    />
  </Button>

  <script is:inline data-astro-rerun>
    ;(() => {
      window.__blogScrollToTopCleanup?.()

      const scrollToTopButton = document.getElementById('scroll-to-top')
      const footer = document.querySelector('footer')

      if (!(scrollToTopButton instanceof HTMLElement)) return
      if (!(footer instanceof HTMLElement)) return

      const handleClick = () => {
        window.scrollTo({ top: 0, behavior: 'smooth' })
      }

      const handleScroll = () => {
        const footerRect = footer.getBoundingClientRect()
        const isFooterVisible = footerRect.top <= window.innerHeight

        scrollToTopButton.classList.toggle(
          'hidden',
          window.scrollY <= 300 || isFooterVisible,
        )
      }

      scrollToTopButton.addEventListener('click', handleClick)
      window.addEventListener('scroll', handleScroll, { passive: true })
      handleScroll()

      window.__blogScrollToTopCleanup = () => {
        scrollToTopButton.removeEventListener('click', handleClick)
        window.removeEventListener('scroll', handleScroll)
      }
    })()
  </script>
</Layout>

<style>
  .post-intro {
    --figure-overlap: clamp(56px, 9vw, 150px);
  }

  .post-intro__inner {
    padding-block: clamp(28px, 3.4vw, 48px) clamp(64px, 8vw, 112px);
  }

  .post-intro--figure .post-intro__inner {
    padding-bottom: 0;
  }

  .post-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    align-items: end;
    gap: clamp(40px, 6vw, 96px);
    margin-top: clamp(48px, 7vw, 96px);
  }

  .post-intro__label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted-foreground);
  }

  .post-intro__title {
    max-width: 18ch;
    margin-top: 22px;
    font-size: clamp(2.4rem, 5.4vw, 5rem);
  }

  .post-intro__description {
    max-width: 40rem;
    margin-top: 26px;
    color: var(--muted-foreground);
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    letter-spacing: -0.01em;
  }

  .post-intro__byline {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .post-intro__author :global(a) {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
  }

  .post-intro__avatar {
    width: 18px;
    height: 18px;
    margin-left: -3px;
    filter: url('#duotone-blue');
  }

  .post-intro__aside {
    position: relative;
    --frame: rgb(255 255 255 / 0.5);
  }

  .post-intro__tab {
    position: absolute;
    bottom: 100%;
    left: 0;
  }

  .post-intro__panel {
    padding: 22px;
  }

  .post-figure {
    --bracket-color: rgb(255 255 255 / 0.7);
    --bracket-top: -16px;
    --bracket-bottom: 22%;
    --bracket-left: -16px;
    --bracket-right: -16px;
    position: relative;
    z-index: 2;
    max-width: 1080px;
    margin: clamp(64px, 8vw, 112px) auto calc(var(--figure-overlap) * -1);
    background: var(--ink);
  }

  .post-figure__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }

  .post-body {
    padding-block: clamp(64px, 8vw, 112px) var(--section-y);
  }

  .post-body--after-figure {
    padding-top: calc(
      var(--figure-overlap, clamp(56px, 9vw, 150px)) + clamp(56px, 7vw, 96px)
    );
  }

  @media (max-width: 1023px) {
    .post-intro__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 56px;
    }

    .post-intro__aside {
      max-width: 420px;
    }
  }
</style>
