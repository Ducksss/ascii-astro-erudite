---
import AuthorCard from '@/components/author-card.astro'
import BlogCard from '@/components/blog-card.astro'
import PageHead from '@/components/page-head.astro'
import PageIntro from '@/components/page-intro.astro'
import Layout from '@/layouts/layout.astro'
import { getAllAuthors, getPostsByAuthor } from '@/lib/data-utils'

export async function getStaticPaths() {
  const authors = await getAllAuthors()
  return authors.map((author) => ({
    params: { id: author.id },
    props: { author },
  }))
}

const { author } = Astro.props
const authorPosts = await getPostsByAuthor(author.id)
const latest = authorPosts[0]
---

<Layout>
  <PageHead
    slot="head"
    title={`${author.data.name} (Author)`}
    description={author.data.bio || `Profile of ${author.data.name}.`}
    noindex
  />

  <PageIntro
    items={[
      { href: '/authors', label: 'Authors' },
      { label: author.data.name },
    ]}
    label="Author profile"
    title={author.data.name}
    description={author.data.bio ||
      `Profile and archive entries for ${author.data.name}.`}
    asideLabel="Profile"
  >
    <dl slot="aside" class="meta-list">
      <div>
        <dt class="t-label">Published notes</dt>
        <dd>{String(authorPosts.length).padStart(2, '0')}</dd>
      </div>
      {
        latest && (
          <div>
            <dt class="t-label">Latest note</dt>
            <dd>{latest.data.title}</dd>
          </div>
        )
      }
      <div>
        <dt class="t-label">Profile</dt>
        <dd>/{author.id}</dd>
      </div>
    </dl>
  </PageIntro>

  <section class="list-section surface-paper">
    <div class="site-container">
      <div class="author-profile">
        <AuthorCard author={author} />
      </div>

      <div class="section-head author-notes">
        <p class="t-label t-muted">Published notes</p>
        <h2 class="t-title">From this author.</h2>
      </div>
      {
        authorPosts.length > 0 ? (
          <div class="author-posts">
            {authorPosts.map((post) => (
              <BlogCard entry={post} />
            ))}
          </div>
        ) : (
          <div class="empty-panel author-posts">
            <p class="t-label">No notes yet</p>
            <p class="t-body mt-4 max-w-xl">
              This profile exists, but there are no published archive entries
              attached to it yet.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .author-profile {
    padding-top: 28px;
  }

  .author-notes {
    margin-top: clamp(72px, 9vw, 128px);
  }

  .author-posts {
    margin-top: clamp(40px, 5vw, 64px);
  }
</style>
