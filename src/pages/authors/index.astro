---
import AuthorCard from '@/components/author-card.astro'
import PageHead from '@/components/page-head.astro'
import PageIntro from '@/components/page-intro.astro'
import Layout from '@/layouts/layout.astro'
import { getAllAuthors, getAllPosts } from '@/lib/data-utils'

const authors = await getAllAuthors()
const posts = await getAllPosts()
const pad = (value: number) => String(value).padStart(2, '0')
---

<Layout>
  <PageHead
    slot="head"
    title="Authors"
    description="Meet the people behind the writing."
  />

  <PageIntro
    items={[{ label: 'Authors' }]}
    label="Authors / profiles"
    title="People behind the notes."
    description="Author profiles and their contributions to the archive of build logs and technical notes."
    asideLabel="Archive"
  >
    <div slot="aside" class="stat-row">
      <div>
        <p class="stat__value">{pad(authors.length)}</p>
        <p class="t-label stat__label">Profiles</p>
      </div>
      <div>
        <p class="stat__value">{pad(posts.length)}</p>
        <p class="t-label stat__label">Published notes</p>
      </div>
    </div>
  </PageIntro>

  <section class="list-section surface-paper">
    <div class="site-container authors">
      {
        authors.length > 0 ? (
          authors.map((author) => <AuthorCard author={author} />)
        ) : (
          <div class="empty-panel">
            <p class="t-label">No authors yet</p>
            <p class="t-body mt-4 max-w-xl">
              Author profiles will appear here once writing is connected to
              registered author entries.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .authors {
    display: grid;
    gap: 72px;
    padding-top: 28px;
  }
</style>
