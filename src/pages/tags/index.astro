---
import ImmersivePageIntro from '@/components/immersive-page-intro.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { getAllPosts, getSortedTags } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

const taggedPosts = await getAllPosts()
const sortedTags = await getSortedTags()
const totalTaggedPosts = taggedPosts.filter(
  (post) => post.data.tags?.length,
).length
const topTag = sortedTags[0]
---

<Layout variant="immersive">
  <PageHead
    slot="head"
    title="Tags"
    description="Browse topics from my build logs, projects, and technical notes."
  />

  <ImmersivePageIntro
    items={[{ label: 'Tags', icon: 'lucide:tags' }]}
    label="Tags"
    title="Follow a thread."
    description="Explore the ideas, tools, and technologies that connect the work."
  >
    <div slot="aside">
      <p class="immersive-eyebrow">At a glance</p>
      <div
        class="mt-6 grid grid-cols-3 gap-px border border-border bg-muted/30"
      >
        <div class="p-4">
          <p
            class="text-2xl leading-none font-normal tracking-[-0.06em] text-foreground"
          >
            {String(sortedTags.length).padStart(2, '0')}
          </p>
          <p class="technical-label mt-2 text-foreground/65">Active tags</p>
        </div>
        <div class="border-x border-border p-4">
          <p
            class="text-2xl leading-none font-normal tracking-[-0.06em] text-foreground"
          >
            {String(totalTaggedPosts).padStart(2, '0')}
          </p>
          <p class="technical-label mt-2 text-foreground/65">Tagged notes</p>
        </div>
        <div class="p-4">
          <p
            class="text-lg leading-tight font-normal tracking-[-0.04em] break-words text-foreground"
          >
            {topTag ? topTag.tag : '--'}
          </p>
          <p class="technical-label mt-2 text-foreground/65">Densest tag</p>
        </div>
      </div>
    </div>
  </ImmersivePageIntro>

  <section class="editorial-section border-b border-border">
    <div class="site-container py-16 lg:py-24">
      {
        sortedTags.length > 0 ? (
          <div class="flex flex-col">
            {sortedTags.map(({ tag, count }) => (
              <Link
                href={`/tags/${tag}`}
                class="group block border-t border-border py-6 first:border-t-0 sm:py-7"
              >
                <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center sm:gap-6">
                  <div class="min-w-0">
                    <p class="technical-label text-foreground/65">
                      Archive tag
                    </p>
                    <h2 class="mt-3 flex items-center gap-3 text-[1.65rem] leading-none font-normal tracking-[-0.05em] text-foreground sm:text-[1.9rem]">
                      <Icon
                        name="lucide:hash"
                        class="size-4 shrink-0 text-foreground/60"
                      />
                      <span class="truncate">{tag}</span>
                    </h2>
                  </div>
                  <p class="technical-label text-foreground/65">
                    {String(count).padStart(2, '0')} posts
                  </p>
                  <div class="immersive-row-arrow group-hover:translate-x-2">
                    open
                  </div>
                </div>
              </Link>
            ))}
          </div>
        ) : (
          <div class="immersive-panel p-6 sm:p-8">
            <p class="landing-section-label">No tags yet</p>
            <p class="immersive-copy mt-4 max-w-xl text-base leading-7">
              Publish tagged notes and the taxonomy directory will populate here
              automatically.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>
