---
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import PageIntro from '@/components/page-intro.astro'
import Layout from '@/layouts/layout.astro'
import { getAllPosts, getSortedTags } from '@/lib/data-utils'

const taggedPosts = await getAllPosts()
const sortedTags = await getSortedTags()
const totalTaggedPosts = taggedPosts.filter(
  (post) => post.data.tags?.length,
).length
const topTag = sortedTags[0]
const pad = (value: number) => String(value).padStart(2, '0')
---

<Layout>
  <PageHead
    slot="head"
    title="Tags"
    description="Browse topics from my build logs, projects, and technical notes."
  />

  <PageIntro
    items={[{ label: 'Tags' }]}
    label="Topics / index"
    title="Follow a thread."
    description="Explore the ideas, tools and technologies that connect the work."
    asideLabel="Index"
  >
    <div slot="aside">
      <div class="stat-row">
        <div>
          <p class="stat__value">{pad(sortedTags.length)}</p>
          <p class="t-label stat__label">Topics</p>
        </div>
        <div>
          <p class="stat__value">{pad(totalTaggedPosts)}</p>
          <p class="t-label stat__label">Tagged notes</p>
        </div>
      </div>
      {
        topTag && (
          <p class="t-label tags-top">
            Densest / <span>#{topTag.tag}</span>
          </p>
        )
      }
    </div>
  </PageIntro>

  <section class="list-section surface-paper">
    <div class="site-container">
      {
        sortedTags.length > 0 ? (
          <ul class="tag-index">
            {sortedTags.map(({ tag, count }) => (
              <li>
                <Link href={`/tags/${tag}`} class="tag-index__link">
                  <span class="t-label t-muted">{pad(count)}</span>
                  <span class="tag-index__name">#{tag}</span>
                  <span class="tag-index__arrow" aria-hidden="true">
                    ↗
                  </span>
                </Link>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty-panel">
            <p class="t-label">No tags yet</p>
            <p class="t-body mt-4 max-w-xl">
              Publish tagged notes and the topic index will populate here
              automatically.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .tags-top {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px dotted var(--rule);
    color: var(--muted-foreground);
  }

  .tags-top span {
    color: var(--foreground);
  }

  .tag-index {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(20px, 3vw, 40px);
  }

  .tag-index__link {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 12px;
    padding-block: 18px;
    border-top: 1px dotted var(--rule);
  }

  .tag-index__name {
    overflow: hidden;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    font-weight: 350;
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .tag-index__arrow {
    font-family: var(--font-mono);
    color: var(--muted-foreground);
  }

  .tag-index__link:hover .tag-index__name,
  .tag-index__link:hover .tag-index__arrow {
    color: var(--blue);
  }

  @media (max-width: 1023px) {
    .tag-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .tag-index {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
