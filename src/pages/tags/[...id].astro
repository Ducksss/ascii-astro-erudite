---
import BlogCard from '@/components/blog-card.astro'
import PageHead from '@/components/page-head.astro'
import PageIntro from '@/components/page-intro.astro'
import Layout from '@/layouts/layout.astro'
import { getAllTags, getPostsByTag } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'

export async function getStaticPaths() {
  const tagMap = await getAllTags()
  const uniqueTags = Array.from(tagMap.keys())

  return Promise.all(
    uniqueTags.map(async (tag) => {
      const posts = await getPostsByTag(tag)
      return {
        params: { id: tag },
        props: {
          tag,
          posts,
        },
      }
    }),
  )
}

const { tag, posts } = Astro.props
const latestPost = posts[0]
const earliestPost = posts[posts.length - 1]
---

<Layout>
  <PageHead
    slot="head"
    title={`Posts tagged with "${tag}"`}
    description={`A collection of posts tagged with ${tag}.`}
    noindex
  />

  <PageIntro
    items={[{ href: '/tags', label: 'Tags' }, { label: tag }]}
    label="Topic"
    title={`#${tag}`}
    description={`Build logs and technical notes about ${tag}.`}
    asideLabel="Topic"
  >
    <dl slot="aside" class="meta-list">
      <div>
        <dt class="t-label">Matching notes</dt>
        <dd>{String(posts.length).padStart(2, '0')}</dd>
      </div>
      {
        latestPost && (
          <div>
            <dt class="t-label">Latest entry</dt>
            <dd>{formatDate(latestPost.data.date)}</dd>
          </div>
        )
      }
      {
        earliestPost && posts.length > 1 && (
          <div>
            <dt class="t-label">First entry</dt>
            <dd>{formatDate(earliestPost.data.date)}</dd>
          </div>
        )
      }
    </dl>
  </PageIntro>

  <section class="list-section surface-paper">
    <div class="site-container">
      <div class="section-head">
        <p class="t-label t-muted">Tagged notes</p>
        <h2 class="t-title">More on this topic.</h2>
      </div>
      {
        posts.length > 0 ? (
          <div class="tag-posts">
            {posts.map((post) => (
              <BlogCard entry={post} />
            ))}
          </div>
        ) : (
          <div class="empty-panel tag-posts">
            <p class="t-label">No notes yet</p>
            <p class="t-body mt-4 max-w-xl">
              This topic exists in the index, but no published notes currently
              resolve to it.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .tag-posts {
    margin-top: clamp(40px, 5vw, 64px);
  }
</style>
