---
import AsciiGenerator from '@/components/dev/ascii-generator'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'

export function getStaticPaths() {
  return [{ params: { slug: 'ascii-signal' } }]
}
const description =
  'Turn your images into monochrome ASCII art, then export a text file or PNG.'
---

<Layout variant="immersive">
  <PageHead
    slot="head"
    title="ASCII Art Playground"
    description={description}
  />
  <section class="playground-section">
    <div class="site-container">
      <AsciiGenerator client:load />
    </div>
  </section>
</Layout>

<style>
  .playground-section {
    background: var(--paper);
    padding-block: 56px 80px;
  }
</style>
