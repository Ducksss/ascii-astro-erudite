---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import AsciiGenerator from '@/components/dev/ascii-generator'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'

export function getStaticPaths() {
  return [{ params: { slug: 'ascii-signal' } }]
}
const description =
  'Turn your images into monochrome ASCII art, then export a text file or PNG.'
---

<Layout>
  <PageHead
    slot="head"
    title="ASCII Art Playground"
    description={description}
  />
  <section class="playground-section surface-paper">
    <div class="site-container">
      <Breadcrumbs items={[{ label: 'ASCII playground' }]} />
      <div class="playground-section__tool">
        <AsciiGenerator client:load />
      </div>
    </div>
  </section>
</Layout>

<style>
  .playground-section {
    padding-block: clamp(28px, 3.4vw, 48px) var(--section-y);
  }

  .playground-section__tool {
    margin-top: clamp(28px, 3.4vw, 48px);
  }
</style>
