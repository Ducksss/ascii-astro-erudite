---
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
---

<Layout variant="immersive">
  <PageHead
    slot="head"
    title="404"
    description="The requested page could not be found."
    noindex
  />
  <section class="editorial-intro error-page">
    <div class="site-container">
      <p class="technical-label">404 / A little off course</p>
      <h1>Lost in the<br />system?</h1>
      <p class="error-page__copy">
        This page couldn't be found.<br />There's still plenty to explore.
      </p>
      <Link href="/" class="technical-button technical-button--white"
        >Return home <span aria-hidden="true">↗</span></Link
      >
      <div class="error-page__links">
        <Link href="/blog" class="immersive-chip">Writing archive</Link>
        <Link href="/about" class="immersive-chip">About</Link>
        <Link href="/tags" class="immersive-chip">Topics</Link>
        <Link href="/authors" class="immersive-chip">Authors</Link>
      </div>
      <img
        src="/static/signal-knot.svg"
        width="928"
        height="804"
        alt=""
        aria-hidden="true"
      />
    </div>
  </section>
</Layout>

<style>
  .error-page {
    overflow: hidden;
    padding-block: 100px 90px;
    min-height: 700px;
    position: relative;
  }
  .error-page .site-container {
    position: relative;
  }
  .error-page h1 {
    position: relative;
    z-index: 1;
    font-size: clamp(72px, 11vw, 160px);
    line-height: 0.9;
    font-weight: 350;
    letter-spacing: -0.065em;
    margin-block: 32px;
  }
  .error-page__copy {
    position: relative;
    z-index: 1;
    font-size: 18px;
    line-height: 1.5;
    color: #e0e0ff;
    margin-bottom: 28px;
  }
  .error-page a {
    position: relative;
    z-index: 1;
  }
  .error-page__links {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .error-page img {
    position: absolute;
    right: -100px;
    bottom: -180px;
    width: 650px;
    opacity: 0.55;
    transform: rotate(-15deg);
  }
  @media (max-width: 767px) {
    .error-page {
      padding-block: 65px;
      min-height: 650px;
    }
    .error-page img {
      right: -200px;
      bottom: -210px;
      width: 480px;
      opacity: 0.2;
    }
  }
</style>
