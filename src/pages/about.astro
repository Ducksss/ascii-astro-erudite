---
import AsciiObject from '@/components/ascii-object.astro'
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { PROFILE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import type { ProfileLink } from '@/types'

const heroLinks = ['LinkedIn', 'Email', 'GitHub'].flatMap(
  (label): ProfileLink[] => {
    const match = PROFILE.links.find((item) => item.label === label)
    return match ? [match] : []
  },
)
const pad = (value: number) => String(value).padStart(2, '0')
---

<Layout>
  <PageHead slot="head" title="About" description={PROFILE.summary} />

  <section class="about-hero surface-blue">
    <span class="field about-hero__field" aria-hidden="true"></span>
    <div class="site-container about-hero__inner">
      <Breadcrumbs items={[{ label: 'About' }]} />

      <h1
        class="t-display about-hero__title rise-in"
        transition:name="page-intro"
      >
        <span>Engineering,</span>
        <span class="about-hero__step">with people in mind.</span>
      </h1>

      <div class="about-hero__grid">
        <div class="about-hero__copy">
          <p class="t-label about-hero__label">
            <span class="mark-cross" aria-hidden="true"></span>
            Chai Pin Zheng / Singapore
          </p>
          <p class="about-hero__summary">{PROFILE.summary}</p>
          <ul class="about-hero__links" aria-label="Contact">
            {
              heroLinks.map((item) => (
                <li>
                  <Link href={item.href} external class="about-hero__link">
                    <span class="t-label">{item.label}</span>
                    <span class="about-hero__note">{item.note}</span>
                    <span aria-hidden="true">↗</span>
                  </Link>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="about-hero__art frame-brackets" aria-hidden="true">
          <span class="tag tag--solid about-hero__tag about-hero__tag--a"
            >NUS Computer Science</span
          >
          <span class="tag about-hero__tag about-hero__tag--b"
            >01° 17′ N / 103° 51′ E</span
          >
          <AsciiObject
            object="cursor"
            tone="blue"
            cols={84}
            rows={50}
            zoom={0.92}
            offsetX={-0.08}
            trails={{ density: 0.34, length: 30, side: 'right' }}
            motion="sway"
            size="clamp(3.6px, 0.6vw, 8.4px)"
          />
        </div>
      </div>

      <dl class="about-hero__metrics">
        {
          PROFILE.metrics.map((metric) => (
            <div>
              <dt class="t-label">{metric.label}</dt>
              <dd>{metric.value.replace(' -> ', ' → ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="experience surface-paper" aria-labelledby="experience-title">
    <div class="site-container">
      <div class="section-head">
        <p class="t-label t-muted">Experience / 2021 – 2026</p>
        <h2 id="experience-title" class="t-title">A record of useful work.</h2>
        <p class="t-body section-head__intro">
          Product onboarding, platform delivery and operational systems. The
          roles, decisions and outcomes behind the work.
        </p>
      </div>

      <div class="roles">
        {
          PROFILE.experience.map((experience, index) => (
            <article id={experience.id} class="role scroll-mt-28">
              <span class="rule-dotted role__rule" aria-hidden="true" />
              <div class="role__grid">
                <div class="role__head">
                  <p class="t-label t-muted">
                    {pad(index + 1)} / {experience.period}
                  </p>
                  <h3 class="role__company">{experience.company}</h3>
                  <p class="role__title">{experience.role}</p>
                </div>
                <div class="role__body">
                  <p class="role__context">{experience.caseStudyContext}</p>
                  <ul class="tree tree--text role__highlights">
                    {experience.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                  <ul class="role__tags" aria-label="Skills">
                    {experience.tags.map((tag) => (
                      <li class="tag tag--quiet">{tag}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="impact-work surface-ink" aria-labelledby="impact-title">
    <span class="field impact-work__field" aria-hidden="true"></span>
    <div class="site-container">
      <div class="section-head">
        <p class="t-label t-muted">
          Projects / open source, volunteering and client work
        </p>
        <h2 id="impact-title" class="t-title">Building beyond the role.</h2>
        <p class="t-body section-head__intro">
          Open-source tools, inclusive hiring and collaborative client work.
          Projects built alongside communities, partners and other engineers.
        </p>
      </div>

      {
        PROFILE.initiatives.map((initiative) => (
          <article class="role role--ink">
            <span class="rule-dotted role__rule" aria-hidden="true" />
            <div class="role__grid">
              <div class="role__head">
                <p class="t-label t-muted">{initiative.period}</p>
                <h3 class="role__company">{initiative.name}</h3>
                <p class="role__title">{initiative.role}</p>
              </div>
              <div class="role__body">
                <p class="role__context">{initiative.summary}</p>
                <ul class="tree tree--text role__highlights">
                  {initiative.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
                <ul class="role__tags" aria-label="Focus areas">
                  {initiative.tags.map((tag) => (
                    <li class="tag tag--quiet">{tag}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="credentials surface-paper"
    aria-labelledby="credentials-title"
  >
    <div class="site-container">
      <div class="section-head">
        <p class="t-label t-muted">Record / study, awards and craft</p>
        <h2 id="credentials-title" class="t-title">The longer story.</h2>
      </div>

      <div class="panels">
        <section class="panel" aria-labelledby="education-title">
          <span class="tab panel__tab" id="education-title">Education</span>
          <div class="frame-double">
            <div class="frame-double__panel panel__body">
              {
                PROFILE.education.map((entry) => (
                  <article class="panel__entry">
                    <p class="t-label t-muted">{entry.period}</p>
                    <h3>{entry.institution}</h3>
                    <p class="panel__meta">{entry.degree}</p>
                    <ul class="tree tree--text">
                      {entry.details.map((detail) => (
                        <li>{detail}</li>
                      ))}
                    </ul>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <section class="panel panel--blue" aria-labelledby="hackathons-title">
          <span class="tab panel__tab" id="hackathons-title">Hackathons</span>
          <div class="frame-double">
            <div class="frame-double__panel panel__body surface-blue">
              <div class="stat-row">
                {
                  PROFILE.hackathonStats.map((stat) => (
                    <div>
                      <p class="stat__value">{stat.value}</p>
                      <p class="t-label stat__label">
                        {stat.label.replace('Devpost ', '')}
                      </p>
                    </div>
                  ))
                }
              </div>
              <ul class="tree tree--text panel__list">
                {PROFILE.hackathonWins.map((win) => <li>{win}</li>)}
              </ul>
              <p class="panel__meta">
                Devpost snapshot: 14 September 2026. Joined events include
                registrations, and submission links can reuse the same project.
              </p>
            </div>
          </div>
        </section>

        <section class="panel" aria-labelledby="awards-title">
          <span class="tab panel__tab" id="awards-title">Awards</span>
          <div class="frame-double">
            <div class="frame-double__panel panel__body">
              <ul class="tree tree--text">
                {PROFILE.awards.map((award) => <li>{award}</li>)}
              </ul>
            </div>
          </div>
        </section>

        <section class="panel" aria-labelledby="leadership-title">
          <span class="tab panel__tab" id="leadership-title">Leadership</span>
          <div class="frame-double">
            <div class="frame-double__panel panel__body">
              {
                PROFILE.leadership.map((entry) => (
                  <article class="panel__entry">
                    <p class="t-label t-muted">{entry.period}</p>
                    <h3>{entry.organization}</h3>
                    <p class="panel__meta">{entry.role}</p>
                    <ul class="tree tree--text">
                      {entry.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <section class="panel panel--wide" aria-labelledby="skills-title">
          <span class="tab panel__tab" id="skills-title">Skills</span>
          <div class="frame-double">
            <div class="frame-double__panel panel__body panel__skills">
              {
                PROFILE.skills.map((group) => (
                  <div>
                    <p class="t-label t-muted">{group.label}</p>
                    <ul class="panel__chips">
                      {group.items.map((item) => (
                        <li class="tag">{item}</li>
                      ))}
                    </ul>
                  </div>
                ))
              }
              <div class="panel__certs">
                <p class="t-label t-muted">Certifications</p>
                <ul class="tree tree--text">
                  {
                    PROFILE.certifications.map((certification) => (
                      <li>{certification}</li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .about-hero {
    overflow: hidden;
  }

  .about-hero__field {
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    color: rgb(255 255 255 / 0.3);
    -webkit-mask: url('/fields/cross-corner.svg') right top / 1100px auto
      no-repeat;
    mask: url('/fields/cross-corner.svg') right top / 1100px auto no-repeat;
  }

  .about-hero__inner {
    position: relative;
    padding-block: clamp(28px, 3.4vw, 48px) clamp(56px, 7vw, 96px);
  }

  .about-hero__title {
    margin-top: clamp(40px, 6vw, 88px);
  }

  .about-hero__title span {
    display: block;
  }

  .about-hero__step {
    padding-left: 1.05em;
  }

  .about-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    margin-top: clamp(40px, 5vw, 72px);
  }

  .about-hero__label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted-foreground);
  }

  .about-hero__summary {
    max-width: 34ch;
    margin-top: 18px;
    font-size: clamp(1.25rem, 1.75vw, 1.6rem);
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .about-hero__links {
    max-width: 520px;
    margin-top: 40px;
    border-top: 1px dotted var(--rule);
  }

  .about-hero__link {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    min-height: 52px;
    border-bottom: 1px dotted var(--rule);
  }

  .about-hero__note {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .about-hero__link:hover .about-hero__note {
    color: #fff;
  }

  .about-hero__art {
    --bracket-color: rgb(255 255 255 / 0.62);
    --bracket-top: 8%;
    --bracket-bottom: 30%;
    position: relative;
    justify-self: end;
    padding-inline: 18px;
  }

  .about-hero__art::after {
    top: 34%;
    bottom: 4%;
  }

  .about-hero__tag {
    position: absolute;
    z-index: 1;
  }

  .about-hero__tag--a {
    top: 4%;
    right: 10%;
  }

  .about-hero__tag--b {
    bottom: 8%;
    left: 10%;
  }

  .about-hero__metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-top: clamp(48px, 6vw, 88px);
    border-top: 1px solid var(--border);
  }

  .about-hero__metrics > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: start;
    gap: 12px;
    padding-top: 22px;
  }

  .about-hero__metrics dt {
    color: var(--muted-foreground);
  }

  .about-hero__metrics dd {
    font-size: clamp(2.2rem, 4vw, 3.75rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  /* Roles */
  .experience,
  .impact-work,
  .credentials {
    padding-block: var(--section-y);
  }

  .roles {
    margin-top: clamp(48px, 6vw, 88px);
  }

  .role + .role {
    margin-top: clamp(40px, 5vw, 72px);
  }

  .role__rule {
    margin-bottom: clamp(28px, 3.4vw, 44px);
  }

  .role__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(28px, 5vw, 88px);
  }

  .role__company {
    margin-top: 14px;
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .role__title {
    max-width: 28ch;
    margin-top: 14px;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.5;
  }

  .role__context {
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    font-weight: 350;
    line-height: 1.38;
    letter-spacing: -0.02em;
  }

  .role__highlights {
    margin-top: 28px;
  }

  .role__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 28px;
  }

  .impact-work {
    overflow: hidden;
  }

  .impact-work__field {
    top: 0;
    right: 0;
    width: 100%;
    height: 620px;
    color: #4a4a4a;
    -webkit-mask: url('/fields/cross-corner.svg') right top no-repeat;
    mask: url('/fields/cross-corner.svg') right top no-repeat;
  }

  .impact-work .site-container {
    position: relative;
  }

  .role--ink {
    margin-top: clamp(48px, 6vw, 88px);
  }

  /* Credentials */
  .panels {
    columns: 2;
    column-gap: clamp(20px, 3vw, 40px);
    margin-top: clamp(64px, 7vw, 104px);
  }

  .panel {
    position: relative;
    break-inside: avoid;
    margin-bottom: clamp(56px, 5.5vw, 80px);
  }

  .panel--wide {
    column-span: all;
    margin-bottom: 0;
  }

  .panel__tab {
    position: absolute;
    bottom: 100%;
    left: 0;
  }

  .panel__body {
    display: grid;
    gap: 28px;
    padding: clamp(20px, 2.4vw, 32px);
    background: var(--paper-raised);
  }

  .panel__body.surface-blue {
    background: var(--blue);
  }

  .panel__entry + .panel__entry {
    padding-top: 26px;
    border-top: 1px dotted var(--rule);
  }

  .panel__entry h3 {
    margin-top: 10px;
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    font-weight: 350;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .panel__meta {
    margin-top: 8px;
    color: var(--muted-foreground);
  }

  .panel__entry .tree {
    margin-top: 16px;
  }

  .panel__list {
    padding-top: 24px;
    border-top: 1px dotted var(--rule);
  }

  .panel__skills {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .panel__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .panel__certs {
    grid-column: 1 / -1;
    padding-top: 24px;
    border-top: 1px dotted var(--rule);
  }

  .panel__certs .tree {
    margin-top: 14px;
    columns: 2;
    column-gap: 40px;
  }

  @media (max-width: 1023px) {
    .about-hero__grid,
    .role__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-hero__art {
      justify-self: center;
    }

    .about-hero__metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 8px;
    }

    .panel__skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .about-hero__title {
      font-size: 11.6vw;
    }

    .about-hero__step {
      padding-left: 0.6em;
    }

    .about-hero__link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 16px;
      padding-block: 10px;
    }

    .about-hero__note {
      grid-row: 2;
    }

    .panels {
      columns: 1;
    }

    .panel__skills {
      grid-template-columns: minmax(0, 1fr);
    }

    .panel__certs .tree {
      columns: 1;
    }
  }
</style>
