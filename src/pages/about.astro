---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import type { ProfileLink } from '@/types'
import { PROFILE } from '@/consts'
import Layout from '@/layouts/layout.astro'

const heroFacts = [
  { label: 'Base', value: 'Singapore' },
  { label: 'Current track', value: 'NUS CS' },
  { label: 'Best fit', value: 'Adoption / tooling / ops' },
]
const heroMetrics = PROFILE.metrics
const heroLinks = ['LinkedIn', 'Email', 'GitHub'].flatMap(
  (label): ProfileLink[] => {
    const match = PROFILE.links.find((item) => item.label === label)
    return match ? [match] : []
  },
)
---

<Layout variant="immersive">
  <PageHead slot="head" title="About" description={PROFILE.summary} />

  <section class="editorial-intro relative overflow-hidden">
    <div class="site-container py-12 lg:py-20">
      <Breadcrumbs
        variant="immersive"
        items={[{ label: 'About', icon: 'lucide:info' }]}
      />

      <div class="about-hero mt-6 xl:mt-8">
        <div
          class="about-hero__main immersive-animate-in"
          transition:name="page-intro"
        >
          <p class="landing-section-label">About</p>
          <h1 class="about-hero__title">Engineering, with people in mind.</h1>

          <p class="about-hero__summary">
            {PROFILE.summary}
          </p>

          <div class="about-hero__impact">
            <p class="about-hero__impact-label">Impact snapshot</p>
            <div class="about-hero__metrics">
              {
                heroMetrics.map((metric) => (
                  <article class="about-hero__metric">
                    <p class="about-hero__metric-value">{metric.value}</p>
                    <p class="about-hero__metric-label">{metric.label}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>

        <aside class="about-hero__rail immersive-animate-in">
          <div class="about-hero__rail-block">
            <p class="about-hero__rail-label">Connect</p>
            <div class="about-hero__links">
              {
                heroLinks.map((item) => (
                  <Link href={item.href} external class="about-hero__link">
                    <span class="about-hero__link-label">{item.label}</span>
                    <span class="about-hero__link-note">{item.note}</span>
                  </Link>
                ))
              }
            </div>
          </div>

          <div class="about-hero__rail-block">
            <p class="about-hero__rail-label">At a glance</p>
            <div class="about-hero__meta">
              {
                heroFacts.map((fact) => (
                  <div class="about-hero__meta-card">
                    <p class="about-hero__meta-label">{fact.label}</p>
                    <p class="about-hero__meta-value">{fact.value}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <p class="about-hero__rail-note">
            Recent work spans MetaLearner, Singapore Armed Forces, GovTech, and
            client delivery.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="editorial-section border-b border-border">
    <div class="site-container py-16 lg:py-24">
      <div class="max-w-3xl border-b border-border pb-8">
        <p class="landing-section-label">Experience</p>
        <h2 class="landing-section-title mt-4 max-w-3xl">
          A record of useful work.
        </h2>
        <p class="immersive-copy mt-6 max-w-2xl text-base leading-7">
          Product onboarding, platform delivery, and operational systems. The
          roles, decisions, and outcomes behind the work.
        </p>
      </div>

      <div class="mt-6 space-y-4 sm:mt-8 sm:space-y-6">
        {
          PROFILE.experience.map((experience) => (
            <article id={experience.id} class="about-case-study scroll-mt-28">
              <div class="about-case-study__header">
                <div>
                  <p class="about-case-study__eyebrow">{experience.period}</p>
                  <h3 class="about-case-study__title">{experience.company}</h3>
                </div>
                <p class="about-case-study__role">{experience.role}</p>
              </div>

              <div class="mt-5 grid gap-5 sm:mt-6 sm:gap-8 lg:grid-cols-[minmax(0,0.76fr)_minmax(0,1.24fr)]">
                <p class="text-base leading-8 text-foreground/65 sm:text-lg">
                  {experience.caseStudyContext}
                </p>
                <div class="space-y-4">
                  {experience.highlights.map((highlight) => (
                    <div class="about-case-study__bullet">{highlight}</div>
                  ))}
                </div>
              </div>

              <div class="mt-5 flex flex-wrap gap-2 sm:mt-6">
                {experience.tags.map((tag) => (
                  <span class="about-chip">{tag}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="editorial-section border-b border-border">
    <div class="site-container py-16 lg:py-24">
      <div class="max-w-3xl border-b border-border pb-8">
        <p class="landing-section-label">Impact work</p>
        <h2 class="landing-section-title mt-4 max-w-2xl">
          Opening doors through better software.
        </h2>
        <p class="immersive-copy mt-6 max-w-2xl text-base leading-7">
          Outside internships and formal roles, this is the clearest example of
          building with both product judgment and social purpose: simplifying
          resume creation, job matching, and employment access for people who
          are often excluded from standard hiring flows.
        </p>
      </div>

      <div class="mt-6 space-y-4 sm:mt-8 sm:space-y-6">
        {
          PROFILE.initiatives.map((initiative) => (
            <article class="about-case-study">
              <div class="about-case-study__header">
                <div>
                  <p class="about-case-study__eyebrow">{initiative.period}</p>
                  <h3 class="about-case-study__title">{initiative.name}</h3>
                </div>
                <p class="about-case-study__role">{initiative.role}</p>
              </div>

              <div class="mt-5 grid gap-5 sm:mt-6 sm:gap-8 lg:grid-cols-[minmax(0,0.76fr)_minmax(0,1.24fr)]">
                <p class="text-base leading-8 text-foreground/65 sm:text-lg">
                  {initiative.summary}
                </p>
                <div class="space-y-4">
                  {initiative.highlights.map((highlight) => (
                    <div class="about-case-study__bullet">{highlight}</div>
                  ))}
                </div>
              </div>

              <div class="mt-5 flex flex-wrap gap-2 sm:mt-6">
                {initiative.tags.map((tag) => (
                  <span class="about-chip">{tag}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="editorial-section">
    <div class="site-container py-16 lg:py-24">
      <div class="grid gap-4 sm:gap-6 xl:grid-cols-2">
        <section class="about-compact-panel immersive-panel p-5 sm:p-8">
          <p class="landing-section-label">Education</p>
          <div class="mt-5 space-y-5 sm:mt-6 sm:space-y-6">
            {
              PROFILE.education.map((entry) => (
                <article class="about-block">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <h2 class="text-2xl leading-none font-normal tracking-[-0.04em] text-foreground">
                      {entry.institution}
                    </h2>
                    <p class="about-block__meta">{entry.period}</p>
                  </div>
                  <p class="mt-3 text-base leading-7 text-foreground/68">
                    {entry.degree}
                  </p>
                  <div class="mt-4 space-y-3">
                    {entry.details.map((detail) => (
                      <div class="about-line-item">{detail}</div>
                    ))}
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="about-compact-panel immersive-panel p-5 sm:p-8">
          <p class="landing-section-label">Awards</p>
          <div class="mt-5 space-y-2 sm:mt-6 sm:space-y-3">
            {
              PROFILE.awards.map((award) => (
                <div class="about-line-item">{award}</div>
              ))
            }
          </div>
        </section>

        <section class="about-compact-panel immersive-panel p-5 sm:p-8">
          <p class="landing-section-label">Hackathons</p>
          <div
            class="about-stats-grid mt-5 grid grid-cols-3 gap-px border border-border bg-transparent sm:mt-6"
          >
            {
              PROFILE.hackathonStats.map((stat) => (
                <div class="about-mini-stat">
                  <p class="about-mini-stat__value">{stat.value}</p>
                  <p class="about-mini-stat__label">{stat.label}</p>
                </div>
              ))
            }
          </div>
          <div class="mt-5 space-y-2 sm:mt-6 sm:space-y-3">
            {
              PROFILE.hackathonWins.map((win) => (
                <div class="about-line-item">{win}</div>
              ))
            }
          </div>
        </section>

        <section class="about-compact-panel immersive-panel p-5 sm:p-8">
          <p class="landing-section-label">Leadership</p>
          <div class="mt-5 space-y-5 sm:mt-6 sm:space-y-6">
            {
              PROFILE.leadership.map((entry) => (
                <article class="about-block">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <h2 class="text-2xl leading-none font-normal tracking-[-0.04em] text-foreground">
                      {entry.organization}
                    </h2>
                    <p class="about-block__meta">{entry.period}</p>
                  </div>
                  <p class="mt-3 text-base leading-7 text-foreground/68">
                    {entry.role}
                  </p>
                  <div class="mt-4 space-y-3">
                    {entry.highlights.map((highlight) => (
                      <div class="about-line-item">{highlight}</div>
                    ))}
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="about-compact-panel immersive-panel p-5 sm:p-8">
          <p class="landing-section-label">Skills</p>
          <div class="mt-5 grid gap-5 sm:mt-6 sm:gap-6">
            {
              PROFILE.skills.map((group) => (
                <article class="about-block">
                  <p class="about-block__meta">{group.label}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {group.items.map((item) => (
                      <span class="about-chip">{item}</span>
                    ))}
                  </div>
                </article>
              ))
            }

            <article class="about-block">
              <p class="about-block__meta">Certifications</p>
              <div class="mt-4 space-y-3">
                {
                  PROFILE.certifications.map((certification) => (
                    <div class="about-line-item">{certification}</div>
                  ))
                }
              </div>
            </article>
          </div>
        </section>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    display: grid;
    gap: 3rem;
  }

  .about-hero__title {
    margin-top: 1rem;
    max-width: 14ch;
    font-size: clamp(3rem, 6.4vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
    font-weight: 300;
    text-wrap: balance;
  }

  .about-hero__summary {
    margin-top: 1.75rem;
    max-width: 38rem;
    font-size: 1rem;
    line-height: 1.75;
    color: rgb(255 255 255 / 80%);
  }

  .about-hero__impact {
    margin-top: 3rem;
  }

  .about-hero__impact-label,
  .about-hero__metric-label,
  .about-hero__rail-label,
  .about-hero__meta-label,
  .about-hero__link-label,
  .about-mini-stat__label,
  .about-case-study__eyebrow,
  .about-block__meta {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .about-hero__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .about-hero__metric {
    padding: 1.2rem 0.8rem 0.25rem 0;
  }

  .about-hero__metric-value {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.055em;
    font-weight: 300;
  }

  .about-hero__metric-label {
    margin-top: 0.65rem;
  }

  .about-hero__rail,
  .about-hero__rail-block {
    display: grid;
    gap: 1.25rem;
  }

  .about-hero__rail {
    align-self: end;
    gap: 2rem;
  }

  .about-hero__links,
  .about-hero__meta {
    border-top: 1px solid var(--border);
  }

  .about-hero__link,
  .about-hero__meta-card {
    display: flex;
    min-height: 44px;
    flex-direction: column;
    gap: 0.45rem;
    border-bottom: 1px solid var(--border);
    padding: 0.85rem 0;
  }

  .about-hero__link:hover .about-hero__link-label {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .about-hero__link-note,
  .about-hero__meta-value,
  .about-hero__rail-note {
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 80%);
  }

  .about-case-study {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
  }

  .about-case-study__header {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .about-case-study__title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
    font-weight: 300;
  }

  .about-case-study__role {
    max-width: 24rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  .about-case-study__bullet,
  .about-line-item {
    border-top: 1px solid var(--border);
    padding-top: 0.85rem;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--muted-foreground);
  }

  .about-chip {
    border: 1px solid var(--border);
    padding: 0.5rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .about-block + .about-block {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .about-mini-stat {
    display: flex;
    min-height: 6rem;
    flex-direction: column;
    justify-content: end;
    gap: 0.6rem;
    padding: 1rem;
  }

  .about-mini-stat__value {
    color: var(--primary);
    font-size: 2rem;
    font-weight: 300;
    letter-spacing: -0.05em;
  }

  @media (min-width: 768px) {
    .about-hero__metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .about-hero {
      grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.65fr);
      gap: 5rem;
    }
  }

  @media (max-width: 767px) {
    .about-hero__impact {
      margin-top: 2rem;
    }

    .about-hero__rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .about-hero__rail-note {
      grid-column: 1 / -1;
    }

    .about-mini-stat {
      padding: 0.75rem;
    }

    .about-compact-panel h2 {
      font-size: 1.4rem;
      line-height: 1.2;
    }
  }
</style>
