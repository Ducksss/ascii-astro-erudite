{
  "name": "ascii-astro-erudite",
  "type": "module",
  "version": "1.6.3",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "test": "tsx --test tests/*.test.ts",
    "preview": "astro preview",
    "astro": "astro",
    "prettier": "prettier --write \"**/*.{ts,tsx,css,astro}\" --ignore-path .gitignore",
    "check": "astro check",
    "test:build": "node --test tests/build.test.mjs",
    "verify": "npm test && npm run build && npm run test:build && npm run test:browser",
    "test:browser": "node --test tests/browser.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@expressive-code/plugin-collapsible-sections": "0.44.2",
    "@expressive-code/plugin-line-numbers": "0.44.2",
    "@iconify-json/lucide": "1.2.138",
    "@shikijs/rehype": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "7.3.5",
    "astro-icon": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.49.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-expressive-code": "0.44.2",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-emoji": "5.0.2",
    "remark-math": "^6.0.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "vite": "8.3.2"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ],
    "tailwindStylesheet": "./src/styles/global.css"
  }
}
